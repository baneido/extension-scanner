{
  "name": "extension-scanner",
  "version": "0.5.0",
  "private": true,
  "description": "Chrome extension threat detector - detects potentially malicious extensions",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "update-blocklist": "node scripts/update-blocklist-snapshot.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "chrome-types": "^0.1.415",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
